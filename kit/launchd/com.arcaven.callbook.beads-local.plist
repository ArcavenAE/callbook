<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.arcaven.callbook.beads-local</string>
  <key>ProgramArguments</key>
  <array>
    <string>__DOLT__</string>
    <string>sql-server</string>
    <string>--config</string>
    <string>__SERVER_DIR__/config.yaml</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__SERVER_DIR__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>__SERVER_DIR__/logs/server.log</string>
  <key>StandardErrorPath</key>
  <string>__SERVER_DIR__/logs/server.err</string>
</dict>
</plist>
